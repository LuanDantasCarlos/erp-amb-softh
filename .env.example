# Copie para .env (não versionado, permissão 600) e ajuste. Em produção (cPanel/Passenger)
# o .env na raiz do projeto é a fonte das variáveis; variáveis já definidas no ambiente têm precedência.

# --- Django ---------------------------------------------------------------------------
# Padrão False. Use True apenas em desenvolvimento local.
DEBUG=False
# Obrigatório com DEBUG=False. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Listas separadas por vírgula, sem espaços extras e sem '*'.
ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# --- Banco (SQLite) -------------------------------------------------------------------
# Caminho absoluto, FORA de public_html. Padrão: <projeto>/db.sqlite3
SQLITE_PATH=
# WAL (padrão), ou DELETE se o diretório do banco estiver em NFS / sistema de arquivos de rede.
SQLITE_JOURNAL_MODE=WAL

# --- Arquivos -------------------------------------------------------------------------
# Padrões: <projeto>/staticfiles e <projeto>/media. Em produção o Apache serve MEDIA_ROOT.
STATIC_ROOT=
MEDIA_ROOT=
# Logs rotativos (só com DEBUG=False). Padrão: <projeto>/logs
LOG_DIR=

# --- HTTPS (só com DEBUG=False) -------------------------------------------------------
# Redireciona http -> https (o proxy precisa enviar X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
# HSTS: deixe 0 até confirmar HTTPS estável; depois 3600 e, por fim, 31536000.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# --- Integração Soul MV (docs/specs/job-importacao-soulmv.md) -------------------------
# Extrator usado pelo job: http (cliente do Soul MV, produção) ou arquivo_local (CSV mais recente do inbox).
SOULMV_EXTRATOR=http
# Pasta de entrada dos CSVs (dados pessoais / LGPD): FORA de public_html, MEDIA_ROOT e static.
SOULMV_INBOX_DIR=
# Arquivo de lock do job. Padrão: <SOULMV_INBOX_DIR>/.job_pacientes_soulmv.lock
SOULMV_LOCK_FILE=
# Dias de retenção dos CSVs no inbox.
SOULMV_RETENCAO_DIAS=7
# Credenciais da conta MV (obrigatórias com SOULMV_EXTRATOR=http). Nunca versionar.
SOULMV_USUARIO=
SOULMV_SENHA=
# Opcionais: valores padrão abaixo. As descrições são casadas sem diferenciar caixa e espaços repetidos.
SOULMV_API_URL=https://regulacao.saude.es.gov.br/consultas-exames/api/
SOULMV_PERFIL=COORDENADOR DE UNIDADE CMCE
SOULMV_UNIDADE_SOLICITANTE=NUCLEO ESPECIAL DE REGULACAO DE CONSULTAS E EXAMES
SOULMV_UNIDADE_EXECUTANTE=RCS SOLUCOES MEDICAS S/A

# --- Estabelecimento impresso nos documentos (opcionais; valores padrão abaixo) -------------
ESTABELECIMENTO_NOME=CRE- METROPOLITANO
ESTABELECIMENTO_CNES=5604613
ESTABELECIMENTO_NUCLEO=Núcleo Regional de Especialidade de Vitória
ESTABELECIMENTO_UNIDADE=Unidade de Oftalmologia
