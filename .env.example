# Configurações de Ambiente
DEBUG=True
SECRET_KEY=sua_chave_secreta_aqui

# Configurações do Banco de Dados
DATABASE_URL=postgres://usuario:senha@localhost:5432/nome_do_banco

# Configurações de Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@exemplo.com
EMAIL_HOST_PASSWORD=sua_senha_de_email

# Configurações do Sistema
ALLOWED_HOSTS=localhost,127.0.0.1,.replit.dev,.replit.app
CSRF_TRUSTED_ORIGINS=https://*.replit.dev,https://*.replit.app,http://localhost:5000,http://127.0.0.1:5000

# Configuração de Tempo
TIME_ZONE=America/Sao_Paulo

# Configurações de Upload
MAX_UPLOAD_SIZE=5242880  # 5MB em bytes