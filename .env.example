# Copie para .env (não versionado) e ajuste. Em produção, prefira as variáveis do
# "Setup Python App" do cPanel; o .env é só um fallback carregado se existir.

# --- Django ---------------------------------------------------------------------------
# Padrão False. Use True apenas em desenvolvimento local.
DEBUG=False
# Obrigatório com DEBUG=False. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Listas separadas por vírgula, sem espaços extras e sem '*'.
ALLOWED_HOSTS=seu-dominio.com.br,www.seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# --- Banco (SQLite) -------------------------------------------------------------------
# Caminho absoluto, FORA de public_html. Padrão: <projeto>/db.sqlite3
SQLITE_PATH=
# WAL (padrão), ou DELETE se o diretório do banco estiver em NFS / sistema de arquivos de rede.
SQLITE_JOURNAL_MODE=WAL

# --- Arquivos -------------------------------------------------------------------------
# Padrões: <projeto>/staticfiles e <projeto>/media. Em produção o Apache serve MEDIA_ROOT.
STATIC_ROOT=
MEDIA_ROOT=
# Logs rotativos (só com DEBUG=False). Padrão: <projeto>/logs
LOG_DIR=

# --- HTTPS (só com DEBUG=False) -------------------------------------------------------
# Redireciona http -> https (o proxy precisa enviar X-Forwarded-Proto).
SECURE_SSL_REDIRECT=True
# HSTS: deixe 0 até confirmar HTTPS estável; depois 3600 e, por fim, 31536000.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# --- Integração Soul MV (docs/specs/job-importacao-soulmv.md) -------------------------
# Extrator usado pelo job: arquivo_local (CSV mais recente do inbox). O cliente HTTP vem na Fase 2.
SOULMV_EXTRATOR=arquivo_local
# Pasta de entrada dos CSVs (dados pessoais / LGPD): FORA de public_html, MEDIA_ROOT e static.
SOULMV_INBOX_DIR=
# Arquivo de lock do job. Padrão: <SOULMV_INBOX_DIR>/.job_pacientes_soulmv.lock
SOULMV_LOCK_FILE=
# Dias de retenção dos CSVs no inbox.
SOULMV_RETENCAO_DIAS=7
# Credenciais da conta MV (usadas pelo cliente HTTP da Fase 2). Nunca versionar.
SOULMV_USUARIO=
SOULMV_SENHA=
